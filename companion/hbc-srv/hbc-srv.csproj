<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <RuntimeIdentifier>linux-arm</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Do not pin a patch version: the TV's runtime is whatever the firmware ships.
         RollForward lets this 3.1 app run on 3.1.x, 5, 6, 7 or 8. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Embedded TV images usually have no ICU; without this the runtime aborts on start. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>hbc-srv</AssemblyName>
    <RootNamespace>HbcSrv</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>
</Project>
